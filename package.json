  "pnpm": {
    "patchedDependencies": {},
    "ignoredBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "esbuild": "^0.28.1",
      "miniflare>sharp": "^0.35.4",
      "miniflare>undici": "^7.29.0",
      "miniflare>ws": "^8.21.0",
      "remark-mdx-frontmatter>toml": "^4.2.0"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
