{
  "name": "basic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler pages dev ./dist",
    "deploy": "$npm_execpath run build && wrangler pages deploy ./dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "install:playwright": "npx playwright install --with-deps chromium",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check:dependencies": "node scripts/check-dependency-compatibility.mjs"
  },
  "private": true,
  "dependencies": {
    "@formkit/tempo": "^1.0.0",
    "hono": "^4.13.5",
    "honox": "^0.1.55",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite-plugin-require": "^1.2.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@cloudflare/workers-types": "^4.20260413.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-ssg": "0.3.3",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/mdx-js__react": "2.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.23",
    "recma-export-filepath": "^1.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-mdx-code-props": "^3.0.1",
    "rehype-mdx-import-media": "^1.4.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.2",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^3.4.0",
    "wrangler": "^4.78.0"
